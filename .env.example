# Copy to .env and uncomment whatever you want to change.
# Every value below is the default, so an empty .env behaves exactly like none.

# --- Logging ---------------------------------------------------------------
# LOG_LEVEL=INFO
# LOG_FORMAT={time:DD/MM/YYYY HH:mm:ss} | {level} | {name} | {message}

# --- Scenes under study ----------------------------------------------------
# Cuprite, Nevada, acquired 2024-09-25 and 2025-02-22. Two separate collects
# over the same ground, which is what makes them worth comparing.
# Point these at other scenes to run the pipeline elsewhere.
# CATALOG_BASE_URL=https://www.planet.com/data/stac/tanager-core-imagery
# SCENE_COLLECTION=energy-mining
# SCENE_IDS=["20240925_185504_87_4001","20250222_190237_16_4001"]

# --- Data ------------------------------------------------------------------
# DATA_DIR=data
# OUTPUT_DIR=outputs
# DEFAULT_ASSETS=["ortho_radiance_hdf5","ortho_sr_hdf5","ortho_visual","ortho_beta_udm"]

# --- Spectral library ------------------------------------------------------
# USGS Spectral Library Version 7, published as one 5.5 GB archive.
# SCIENCEBASE_BASE_URL=https://www.sciencebase.gov/catalog
# SPLIB07_ITEM_ID=5807a2a2e4b0841e59e3a18d
# SPLIB07_ARCHIVE_NAME=usgs_splib07.zip

# --- Minerals --------------------------------------------------------------
# Reference spectra to match pixels against, under the group each is reported
# as. A species appears exactly once, so the groups are the whole list.
#
# Names are file stems from the archive, without its prefix and the `.txt`.
# Any chapter of the library can be named, not only the minerals. The trailing
# code is the laboratory instrument: ASDNG is the sharpest available and the
# only one that nearly matches Tanager's bands, so anything else is reported
# as blunter by the `references` command.
#
# The minerals below are the alteration assemblage at Cuprite. Kaolinite,
# dickite and halloysite share a group because their spectra are too alike to
# tell apart at 30 m, so a pixel is reported as the group rather than as one
# of them.
# MINERAL_GROUPS={"alunite":["Alunite_HS295.3B_ASDNGa_AREF"],"kaolinite_group":["Kaolinite_KGa-1_(wxl)_ASDNGb_AREF","Dickite_NMNH106242_ASDNGb_AREF","Halloysite_NMNH106237_ASDNGa_AREF"],"muscovite":["Muscovite_GDS113_Ruby_ASDNGa_AREF"],"montmorillonite":["Montmorillonite_SWy-1_ASDNGb_AREF"],"pyrophyllite":["Pyrophyllite_PYS1A_lt850um_ASDNGa_AREF"],"carbonate":["Calcite_WS272_ASDNGa_AREF"]}
#
# Spectra matched against but never reported as a mineral. Every pixel is
# given the nearest reference, so ground that is not rock takes a mineral's
# name unless something truer is offered. The defaults are dead vegetation,
# which a greenness mask cannot see and whose cellulose absorbs where
# carbonate does; without them a sixth of a Cuprite scene comes back as
# carbonate that is really dry grass.
# NONMINERAL_SPECTRA=["Grass_AETR70_CA01-AETR-2_NPV_ASDFRa_AREF","Grass_AETR95_CA01-AETR-1_NPV_ASDFRa_AREF","Grass_CA01-TACA-1_meadow_NPV_ASDFRa_AREF"]
#
# Wavelengths the minerals are told apart in, in nanometres. Change it with
# care: a band depth measured in one window is not comparable to one measured
# in another, and a bound that cuts into a feature understates its depth.
# MATCH_RANGE=[2080.0,2490.0]

# --- Masking ---------------------------------------------------------------
# Which pixels the matcher is allowed to see. Every run reports how many each
# of these removes, so their effect is visible rather than assumed.
#
# Pixels greener than this are left out, since plants absorb in the same
# region the minerals are told apart in. For a new site, sweep it and compare
# what each date masks: set too low it tracks vegetation coming and going with
# the season, which makes the mask depend on when the scene was taken.
# VEGETATION_NDVI=0.2
#
# Pixels darker than this in the shortwave are left out. Shadow and water
# reflect too little for an absorption to stand above the noise.
# DARK_REFLECTANCE=0.05
#
# The bands averaged to work out how green a pixel is.
# RED_NM=[660.0,680.0]
# NEAR_INFRARED_NM=[850.0,870.0]

# --- Downloads -------------------------------------------------------------
# Seconds before a catalog or asset request gives up.
# REQUEST_TIMEOUT=60
# Bytes held in memory while streaming a download (8 MiB).
# DOWNLOAD_CHUNK_SIZE=8388608
