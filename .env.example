# Copy to .env and uncomment whatever you want to change.
# Every value below is the default, so an empty .env behaves exactly like none.

# --- Logging ---------------------------------------------------------------
# LOG_LEVEL=INFO
# LOG_FORMAT={time:DD/MM/YYYY HH:mm:ss} | {level} | {name} | {message}

# --- Scene under study -----------------------------------------------------
# Singrauli coalfield, Madhya Pradesh, India, acquired 2025-03-05.
# Point these at another scene to run the pipeline elsewhere.
# CATALOG_BASE_URL=https://www.planet.com/data/stac/tanager-core-imagery
# SCENE_COLLECTION=energy-mining
# SCENE_ID=20250305_053421_32_4001

# --- Data ------------------------------------------------------------------
# DATA_DIR=data
# DEFAULT_ASSETS=["ortho_radiance_hdf5","ortho_sr_hdf5","ortho_visual","ortho_beta_udm"]

# --- Downloads -------------------------------------------------------------
# Seconds before a catalog or asset request gives up.
# REQUEST_TIMEOUT=60
# Bytes held in memory while streaming a download (8 MiB).
# DOWNLOAD_CHUNK_SIZE=8388608
